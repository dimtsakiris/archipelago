    {
      "@id": "wd:Q465",
      "@type": [
        "http://purl.org/dc/dcmitype/Collection",
        "dcat:Dataset"
      ],
      "dcterms:creator": "Σοφία Ντώνα",
      "dcterms:description": [
        {
          "@language": "el",
          "@value": "Ανατεθειμένο πολυμεσικό δοκιμιακό φιλμ και συνοδευτικές τρισδιάστατες σαρώσεις της εικαστικού Σοφίας Ντώνα, που δημιουργήθηκαν κατά τη διαμονή της στη Σέριφο το 2025, αναδεικνύοντας τον ρόλο των γυναικών στην απεργία των μεταλλωρύχων του Μεγάλου Λιβαδιού το 1916."
        },
        {
          "@language": "en",
          "@value": "A commissioned multimedia essay film and accompanying 3D scans by visual artist Sofia Dona, made during a 2025 residency on Serifos, uncovering women's role in the 1916 Mega Livadi miners' strike."
        }
      ],
      "dcterms:identifier": "ecdt_collection_serifos_dona",
      "dcterms:isPartOf": {
        "@id": "https://archipelago-wikibase.wikibase.cloud/dataset/archipelago"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:title": [
        {
          "@language": "el",
          "@value": "Νέα παραγωγή: «Λιθοβολούσες» της Σοφίας Ντώνα (Σέριφος)"
        },
        {
          "@language": "en",
          "@value": "Commission: \"Stonethrowers\" by Sofia Dona (Serifos)"
        }
      ],
      "rdfs:label": [
        {
          "@language": "el",
          "@value": "Νέα παραγωγή: «Λιθοβολούσες» της Σοφίας Ντώνα (Σέριφος)"
        },
        {
          "@language": "en",

        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:title": [
        {
          "@language": "el",
          "@value": "Νέα παραγωγή: Ignacio Acosta - «Σέριφος: Σιδηρές επιτελέσεις»"
        },
        {
          "@language": "en",
          "@value": "Commission: Ignacio Acosta - \"Serifos: Iron Enactments\""
        }
      ],
      "rdfs:label": [
        {
          "@language": "el",
          "@value": "Νέα παραγωγή: Ignacio Acosta - «Σέριφος: Σιδηρές επιτελέσεις»"

    {
      "@id": "wd:Q456",
      "@type": [
        "http://purl.org/dc/dcmitype/Collection",
        "http://www.w3.org/ns/dcat#Dataset"
      ],
      "dcterms:creator": "Μανώλης Δ. Μανωλάς",
      "dcterms:description": [
        {
          "@language": "el",
          "@value": "Φωτογραφίες, ηχητικά ντοκουμέντα και βίντεο από το προσωπικό αρχείο του ερευνητή και χρονικογράφου Μανώλη Δ. Μανωλά (1947-2021), που τεκμηριώνουν τη σμυριδωρυχεία, τη μεταφορά σμύριδας και την κοινοτική ζωή στην Κόρωνο Νάξου, από τις αρχές του 20ού αιώνα έως τη δεκαετία του 1990."
        },
        {
          "@language": "en",
          "@value": "Photographs, sound recordings and video from the personal archive of researcher and local chronicler Manolis D. Manolas (1947-2021), documenting emery mining, transport and community life in Koronos, Naxos, from the early 1900s to the 1990s."
        }
      ],
      "dcterms:identifier": "ecdt_collection_naxos_manolas",
      "dcterms:isPartOf": {
        "@id": "https://archipelago-wikibase.wikibase.cloud/dataset/archipelago"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:title": [
        {
          "@language": "el",
          "@value": "Αρχείο Μανώλη Δ. Μανωλά (Νάξος)"
        },
        {
          "@language": "en",
          "@value": "Manolis D. Manolas archive (Naxos)"
        }
      ],
      "http://rdfs.org/ns/void#entities": 13,
      "rdfs:label": [
        {
          "@language": "el",
          "@value": "Αρχείο Μανώλη Δ. Μανωλά (Νάξος)"
        },
        {
          "@language": "en",
          "@value": "Manolis D. Manolas archive (Naxos)"
        }
      ],
      "rdfs:seeAlso": {
        "@id": "https://archipelago-wikibase.wikibase.cloud/wiki/Item:Q456"
      },
      "schema:description": [
        {
          "@language": "el",
          "@value": "Φωτογραφίες, ηχητικά ντοκουμέντα και βίντεο από το προσωπικό αρχείο του ερευνητή και χρονικογράφου Μανώλη Δ. Μανωλά (1947-2021), που τεκμηριώνουν τη σμυριδωρυχεία, τη μεταφορά σμύριδας και την κοινοτική ζωή στην Κόρωνο Νάξου, από τις αρχές του 20ού αιώνα έως τη δεκαετία του 1990."
        },
        {
          "@language": "en",
          "@value": "Photographs, sound recordings and video from the personal archive of researcher and local chronicler Manolis D. Manolas (1947-2021), documenting emery mining, transport and community life in Koronos, Naxos, from the early 1900s to the 1990s."
        }
      ],
      "wdt:P1": {
        "@id": "wd:Q2"
      },
